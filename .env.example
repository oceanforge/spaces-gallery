# Copy to .env and fill in your DigitalOcean Spaces credentials.

SPACES_KEY=your-access-key
SPACES_SECRET=your-secret-key
SPACES_REGION=nyc3
SPACES_BUCKET=your-bucket-name

# Optional overrides
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_CDN_ENDPOINT=https://your-bucket.nyc3.cdn.digitaloceanspaces.com
# PORT=8080
# How long (seconds) the CDN/browsers may cache uploaded images. Default 1 year.
# CACHE_MAX_AGE=31536000
# Let browsers upload straight to Spaces (needs a CORS rule on the bucket, see README).
# DIRECT_UPLOADS=1

# Flask session secret, used for flash messages. A dev fallback is used if unset;
# set a strong random value in production.
# SECRET_KEY=change-me
